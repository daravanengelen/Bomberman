# Doxyfile for Bomberman
PROJECT_NAME           = "Bomberman"
PROJECT_NUMBER         = "0.1.0"
PROJECT_BRIEF          = "Bomberman AP project retake"
OUTPUT_DIRECTORY       = docs/doxygen
CREATE_SUBDIRS         = YES
ALIASES               += "TODO=TODO:"

OPTIMIZE_OUTPUT_FOR_C  = NO
OPTIMIZE_OUTPUT_JAVA   = NO
BUILTIN_STL_SUPPORT    = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_PACKAGE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
SHOW_USED_FILES        = YES
SHOW_FILES             = YES
SHOW_NAMESPACES        = YES

RECURSIVE              = YES
FILE_PATTERNS          = *.cpp *.h *.hpp
INPUT                  = libs/logic/include libs/logic/src src/view
IGNORE_PATTERNS        = */build/* */build-*/* */.git/*

SOURCE_BROWSER         = YES
INLINE_SOURCES         = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
GENERATE_LATEX         = NO
GENERATE_XML           = NO
GENERATE_DOCSET        = NO

MARKDOWN_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 6

QUIET                  = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = NO

# Good defaults for a C++ project
EXTRACT_ANON_NSPACES = YES
INLINE_INHERITED_MEMB = YES

# Add project root where headers are included from
STRIP_FROM_PATH        = .

# Use the README and generated docs landing page
USE_MDFILE_AS_MAINPAGE = README.md
